# Copy this file to .env and adjust.

# Which backend answers the chat:
#   true  -> local model via Ollama (or any OpenAI-compatible server)
#   false -> the Claude API
USE_LOCAL=true

# --- local backend settings (used when USE_LOCAL=true) ---
LOCAL_BASE_URL=http://localhost:11434/v1
LOCAL_MODEL=qwen2.5:14b

# --- Claude backend settings (used when USE_LOCAL=false) ---
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-opus-5
